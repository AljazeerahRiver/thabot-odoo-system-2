<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_thabot_ai_provider_config_list" model="ir.ui.view">
        <field name="name">thabot.ai.provider.config.list</field>
        <field name="model">thabot.ai.provider.config</field>
        <field name="arch" type="xml">
            <list string="Provider Configurations">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="provider"/>
                <field name="default_model"/>
                <field name="is_default"/>
                <field name="api_key_set" string="Key Configured"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_thabot_ai_provider_config_form" model="ir.ui.view">
        <field name="name">thabot.ai.provider.config.form</field>
        <field name="model">thabot.ai.provider.config</field>
        <field name="arch" type="xml">
            <form string="Provider Configuration">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Gemini Production"/></h1>
                    </div>
                    <group>
                        <group string="Provider">
                            <field name="provider"/>
                            <field name="default_model"/>
                            <field name="api_base_url"/>
                            <field name="timeout"/>
                            <field name="is_default"/>
                            <field name="active" invisible="1"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group string="Credentials">
                            <field name="api_key_parameter"/>
                            <field name="api_key_env_var" placeholder="e.g. GEMINI_API_KEY"/>
                            <field name="api_key_input" password="True"
                                   placeholder="Paste a key to store it in the system parameter"/>
                            <field name="api_key_set"/>
                            <button name="action_clear_api_key" type="object" string="Clear stored key"
                                    class="btn-link" icon="fa-eraser" invisible="not api_key_set"/>
                        </group>
                        <group string="Google Cloud" invisible="provider != 'vertex_ai'">
                            <field name="gcp_project"/>
                            <field name="gcp_location"/>
                        </group>
                        <group string="Cost Tracking">
                            <field name="currency_id" groups="base.group_multi_currency"/>
                            <field name="price_per_1k_input"/>
                            <field name="price_per_1k_output"/>
                        </group>
                    </group>
                    <div class="alert alert-info" role="alert">
                        API keys are never stored on this record: they are written to the system
                        parameter above, or read from the environment variable as a fallback.
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_thabot_ai_provider_config_search" model="ir.ui.view">
        <field name="name">thabot.ai.provider.config.search</field>
        <field name="model">thabot.ai.provider.config</field>
        <field name="arch" type="xml">
            <search string="Provider Configurations">
                <field name="name"/>
                <field name="default_model"/>
                <filter name="filter_default" string="Default" domain="[('is_default', '=', True)]"/>
                <separator/>
                <filter name="filter_gemini" string="Gemini" domain="[('provider', '=', 'gemini')]"/>
                <filter name="filter_vertex" string="Vertex AI" domain="[('provider', '=', 'vertex_ai')]"/>
                <filter name="filter_openai" string="OpenAI" domain="[('provider', '=', 'openai')]"/>
                <separator/>
                <filter name="filter_inactive" string="Archived" domain="[('active', '=', False)]"/>
                <group>
                    <filter name="group_provider" string="Provider" domain="[]" context="{'group_by': 'provider'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_thabot_ai_provider_config" model="ir.actions.act_window">
        <field name="name">Provider Configurations</field>
        <field name="res_model">thabot.ai.provider.config</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Configure your first AI provider</p>
            <p>Store the endpoint and pricing here, and keep the secret in a system parameter.</p>
        </field>
    </record>

</odoo>
